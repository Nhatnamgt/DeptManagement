@page
@model DeptManagement.RazorPage.Pages.QuanLiNapRut.NaprutModel
@{
    ViewData["Title"] = "Quản lý nạp rút";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1>Quản lý nạp rút</h1>
        <p>Theo dõi giao dịch nạp, rút và lãi/lỗ</p>
    </div>
    <button type="button" class="btn btn-primary" id="btnAdd">
        <i class="bi bi-plus-lg me-1"></i> Thêm giao dịch
    </button>
</div>

<div id="alertBox"></div>

<div class="stat-grid">
    <div class="stat-card stat-success">
        <div class="stat-label">Tổng tiền nạp</div>
        <div class="stat-value" id="tongTienNap">0</div>
    </div>
    <div class="stat-card stat-danger">
        <div class="stat-label">Tổng tiền rút</div>
        <div class="stat-value" id="tongTienRut">0</div>
    </div>
    <div class="stat-card stat-primary" id="laiLoCard">
        <div class="stat-label">Tổng lãi/lỗ</div>
        <div class="stat-value" id="soTienLaiLo">0</div>
    </div>
</div>

<div class="content-card">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-list-ul text-primary"></i>
        Danh sách giao dịch
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table data-table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ngày nạp</th>
                        <th>Số tiền nạp</th>
                        <th>Ngày rút</th>
                        <th>Số tiền rút</th>
                        <th>Lãi/Lỗ</th>
                        <th>Ghi chú</th>
                        <th class="text-end" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    <tr>
                        <td colspan="8" class="empty-state text-center">
                            <i class="bi bi-hourglass-split"></i>
                            Đang tải dữ liệu...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="formModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm giao dịch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="itemId" value="0" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="ngayNap" class="form-label">Ngày nạp</label>
                        <input type="date" class="form-control" id="ngayNap" />
                    </div>
                    <div class="col-md-6">
                        <label for="soTienNap" class="form-label">Số tiền nạp</label>
                        <input type="number" class="form-control" id="soTienNap" min="0" step="1000" value="0" />
                    </div>
                    <div class="col-md-6">
                        <label for="ngayRut" class="form-label">Ngày rút</label>
                        <input type="date" class="form-control" id="ngayRut" />
                    </div>
                    <div class="col-md-6">
                        <label for="soTienRut" class="form-label">Số tiền rút</label>
                        <input type="number" class="form-control" id="soTienRut" min="0" step="1000" value="0" />
                    </div>
                    <div class="col-12">
                        <label for="ghiChu" class="form-label">Ghi chú</label>
                        <textarea class="form-control" id="ghiChu" rows="3" placeholder="Nhập ghi chú cho giao dịch (tuỳ chọn)"></textarea>
                        <div class="form-text form-text-hint">Ví dụ: nguồn tiền, mục đích sử dụng...</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSave">
                    <i class="bi bi-check-lg me-1"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE = '@Model.ApiBaseUrl';
        const API_URL = `${API_BASE}/QuanLiNapRut`;
        const formModal = new bootstrap.Modal(document.getElementById('formModal'));
        const { formatMoney, formatDate, formatNote, showAlert } = AppUtils;

        async function loadTongLaiLo() {
            const response = await fetch(`${API_URL}/tong-lai-lo`);
            if (!response.ok) throw new Error('Không thể tải tổng lãi/lỗ');
            const data = await response.json();

            document.getElementById('tongTienNap').textContent = formatMoney(data.tongTienNap);
            document.getElementById('tongTienRut').textContent = formatMoney(data.tongTienRut);

            const laiLoElement = document.getElementById('soTienLaiLo');
            const laiLoCard = document.getElementById('laiLoCard');
            laiLoElement.textContent = formatMoney(data.soTienLaiLo);
            laiLoCard.classList.remove('stat-success', 'stat-danger', 'stat-primary');
            laiLoCard.classList.add(data.soTienLaiLo >= 0 ? 'stat-success' : 'stat-danger');
        }

        async function loadData() {
            const tbody = document.getElementById('tableBody');
            try {
                const response = await fetch(API_URL);
                if (!response.ok) throw new Error('Không thể tải dữ liệu');
                const data = await response.json();

                if (!data.length) {
                    tbody.innerHTML = `<tr><td colspan="8" class="empty-state text-center">
                        <i class="bi bi-inbox"></i>Chưa có giao dịch nào</td></tr>`;
                    return;
                }

                const sortedData = [...data].sort((a, b) => {
                    const dateA = new Date(a.ngayNap || a.ngayRut || '9999-12-31').getTime();
                    const dateB = new Date(b.ngayNap || b.ngayRut || '9999-12-31').getTime();
                    return dateA - dateB || a.id - b.id;
                });

                tbody.innerHTML = sortedData.map(item => `
                    <tr>
                        <td><span class="text-muted">#${item.id}</span></td>
                        <td>${formatDate(item.ngayNap)}</td>
                        <td class="money-cell text-success">${formatMoney(item.soTienNap)}</td>
                        <td>${formatDate(item.ngayRut)}</td>
                        <td class="money-cell text-danger">${formatMoney(item.soTienRut)}</td>
                        <td class="money-cell ${item.laiLo >= 0 ? 'text-success' : 'text-danger'}">${formatMoney(item.laiLo)}</td>
                        <td>${formatNote(item.ghiChu)}</td>
                        <td>
                            <div class="btn-action-group">
                                <button class="btn btn-sm btn-outline-primary btn-action" onclick="openEdit(${item.id})" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger btn-action" onclick="deleteItem(${item.id})" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join('');
            } catch (error) {
                tbody.innerHTML = `<tr><td colspan="8" class="empty-state text-center text-danger">${error.message}</td></tr>`;
            }
        }

        function resetForm() {
            document.getElementById('itemId').value = '0';
            document.getElementById('ngayNap').value = '';
            document.getElementById('soTienNap').value = '0';
            document.getElementById('ngayRut').value = '';
            document.getElementById('soTienRut').value = '0';
            document.getElementById('ghiChu').value = '';
            document.getElementById('modalTitle').textContent = 'Thêm giao dịch';
        }

        document.getElementById('btnAdd').addEventListener('click', () => {
            resetForm();
            formModal.show();
        });

        async function openEdit(id) {
            try {
                const response = await fetch(API_URL);
                if (!response.ok) throw new Error('Không thể tải dữ liệu');
                const data = await response.json();
                const item = data.find(x => x.id === id);
                if (!item) throw new Error('Không tìm thấy giao dịch');

                document.getElementById('itemId').value = item.id;
                document.getElementById('ngayNap').value = item.ngayNap || '';
                document.getElementById('soTienNap').value = item.soTienNap;
                document.getElementById('ngayRut').value = item.ngayRut || '';
                document.getElementById('soTienRut').value = item.soTienRut;
                document.getElementById('ghiChu').value = item.ghiChu || '';
                document.getElementById('modalTitle').textContent = 'Sửa giao dịch';
                formModal.show();
            } catch (error) {
                showAlert('alertBox', error.message, 'danger');
            }
        }

        document.getElementById('btnSave').addEventListener('click', async () => {
            const id = parseInt(document.getElementById('itemId').value, 10);
            const payload = {
                id: id,
                ngayNap: document.getElementById('ngayNap').value || null,
                soTienNap: parseFloat(document.getElementById('soTienNap').value) || 0,
                ngayRut: document.getElementById('ngayRut').value || null,
                soTienRut: parseFloat(document.getElementById('soTienRut').value) || 0,
                laiLo: 0,
                ghiChu: document.getElementById('ghiChu').value.trim() || null
            };

            const isEdit = id > 0;
            const btnSave = document.getElementById('btnSave');
            btnSave.disabled = true;
            try {
                const response = await fetch(API_URL, {
                    method: isEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    const err = await response.text();
                    throw new Error(err || 'Lưu thất bại');
                }

                formModal.hide();
                showAlert('alertBox', isEdit ? 'Cập nhật thành công' : 'Thêm mới thành công');
                await loadData();
                await loadTongLaiLo();
            } catch (error) {
                showAlert('alertBox', error.message, 'danger');
            } finally {
                btnSave.disabled = false;
            }
        });

        async function deleteItem(id) {
            if (!confirm('Bạn có chắc muốn xóa giao dịch này?')) return;

            try {
                const response = await fetch(`${API_URL}/${id}`, { method: 'DELETE' });
                if (!response.ok) throw new Error('Xóa thất bại');
                showAlert('alertBox', 'Xóa thành công');
                await loadData();
                await loadTongLaiLo();
            } catch (error) {
                showAlert('alertBox', error.message, 'danger');
            }
        }

        loadData();
        loadTongLaiLo().catch(error => showAlert('alertBox', error.message, 'danger'));
    </script>
}
