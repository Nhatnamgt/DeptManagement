@page
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero-section">
    <h1>Quản lý tài chính cá nhân</h1>
    <p>Theo dõi khoản vay, chi tiết nợ và các giao dịch nạp rút một cách dễ dàng.</p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <a class="feature-card" asp-page="/QuanLyKhoanVay/Khoanvay">
            <div class="feature-icon icon-loan">
                <i class="bi bi-bank"></i>
            </div>
            <h5>Quản lý khoản vay</h5>
            <p>Quản lý danh sách khoản nợ, chi tiết từng khoản vay và thống kê tổng tiền phải trả.</p>
            <span class="feature-link">Xem chi tiết <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>
    <div class="col-md-6">
        <a class="feature-card" asp-page="/QuanLiNapRut/Naprut">
            <div class="feature-icon icon-cash">
                <i class="bi bi-arrow-left-right"></i>
            </div>
            <h5>Quản lý nạp rút</h5>
            <p>Theo dõi giao dịch nạp, rút tiền và tính toán lãi/lỗ tự động.</p>
            <span class="feature-link">Xem chi tiết <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>
</div>
