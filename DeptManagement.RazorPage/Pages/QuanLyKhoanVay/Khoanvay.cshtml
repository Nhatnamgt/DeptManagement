@page
@model DeptManagement.RazorPage.Pages.QuanLyKhoanVay.IndexModel
@{
    ViewData["Title"] = "Quản lý khoản vay";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <h1>Quản lý khoản vay</h1>
        <p>Quản lý khoản nợ và chi tiết từng khoản vay</p>
    </div>
    <button type="button" class="btn btn-primary" id="btnAddKhoanNo">
        <i class="bi bi-plus-lg me-1"></i> Thêm khoản nợ
    </button>
</div>

<div id="alertBox"></div>

<div class="content-card mb-4">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-folder2-open text-primary"></i>
        Danh sách khoản nợ
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table data-table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên khoản nợ</th>
                        <th>Ghi chú</th>
                        <th class="text-end" style="width: 200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="khoanNoTableBody">
                    <tr>
                        <td colspan="4" class="empty-state text-center">
                            <i class="bi bi-hourglass-split"></i>
                            Đang tải dữ liệu...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="content-card d-none" id="chiTietSection">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="d-flex align-items-center gap-2">
            <i class="bi bi-receipt text-primary"></i>
            Chi tiết khoản vay:
            <strong id="selectedKhoanNoName" class="text-primary"></strong>
        </span>
        <button type="button" class="btn btn-sm btn-primary" id="btnAddChiTiet">
            <i class="bi bi-plus-lg me-1"></i> Thêm chi tiết
        </button>
    </div>
    <div class="card-body p-3">
        <div class="stat-grid" id="thongKeBox">
            <div class="stat-card stat-primary">
                <div class="stat-label">Tổng tiền vay</div>
                <div class="stat-value" id="tongTienVay">0</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Tổng tiền lãi</div>
                <div class="stat-value" id="tongTienLai">0</div>
            </div>
            <div class="stat-card stat-danger">
                <div class="stat-label">Tổng tiền phải trả</div>
                <div class="stat-value" id="tongTienPhaiTra">0</div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table data-table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ngày vay</th>
                        <th>Số tiền vay</th>
                        <th>Số tiền lãi</th>
                        <th>Trả mỗi tháng</th>
                        <th>Ngày đến hạn</th>
                        <th>Tổng tiền</th>
                        <th>Ghi chú</th>
                        <th class="text-end" style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="chiTietTableBody">
                    <tr>
                        <td colspan="9" class="empty-state text-center">
                            Chọn khoản nợ để xem chi tiết
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="khoanNoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="khoanNoModalTitle">Thêm khoản nợ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="khoanNoId" value="0" />
                <div class="mb-3">
                    <label for="tenKhoanNo" class="form-label">Tên khoản nợ <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="tenKhoanNo" required placeholder="VD: Vay ngân hàng ABC" />
                </div>
                <div class="mb-0">
                    <label for="ghiChuKhoanNo" class="form-label">Ghi chú</label>
                    <textarea class="form-control" id="ghiChuKhoanNo" rows="3" placeholder="Ghi chú về khoản nợ (tuỳ chọn)"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSaveKhoanNo">
                    <i class="bi bi-check-lg me-1"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="chiTietModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="chiTietModalTitle">Thêm chi tiết khoản vay</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="chiTietId" value="0" />
                <input type="hidden" id="chiTietKhoanNoId" value="0" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="ngayVay" class="form-label">Ngày vay <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="ngayVay" required />
                    </div>
                    <div class="col-md-6">
                        <label for="soTienVay" class="form-label">Số tiền vay</label>
                        <input type="number" class="form-control" id="soTienVay" min="0" step="1000" value="0" />
                    </div>
                    <div class="col-md-6">
                        <label for="soTienLai" class="form-label">Số tiền lãi</label>
                        <input type="number" class="form-control" id="soTienLai" min="0" step="1000" value="0" />
                    </div>
                    <div class="col-md-6">
                        <label for="soTienTraMoiKy" class="form-label">Số tiền trả mỗi tháng</label>
                        <input type="number" class="form-control" id="soTienTraMoiKy" min="0" step="1000" value="0" />
                    </div>
                    <div class="col-md-6">
                        <label for="soNgayTra" class="form-label">Ngày đến hạn</label>
                        <input type="number" class="form-control" id="soNgayTra" min="0" value="0" />
                    </div>
                    <div class="col-md-6">
                        <label for="tongTien" class="form-label">Tổng tiền</label>
                        <input type="number" class="form-control" id="tongTien" min="0" step="1000" value="0" />
                    </div>
                    <div class="col-12">
                        <label for="ghiChuChiTiet" class="form-label">Ghi chú</label>
                        <textarea class="form-control" id="ghiChuChiTiet" rows="3" placeholder="Ghi chú cho khoản vay này (tuỳ chọn)"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSaveChiTiet">
                    <i class="bi bi-check-lg me-1"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE = '@Model.ApiBaseUrl';
        const KHOAN_NO_URL = `${API_BASE}/QuanLiKhoanNo`;
        const CHI_TIET_URL = `${API_BASE}/ChiTietKhoanVay`;

        let khoanNoList = [];
        let selectedKhoanNoId = 0;
        let chiTietList = [];

        const khoanNoModal = new bootstrap.Modal(document.getElementById('khoanNoModal'));
        const chiTietModal = new bootstrap.Modal(document.getElementById('chiTietModal'));
        const { formatMoney, formatDate, formatNote, showAlert, escapeHtml } = AppUtils;

        async function loadKhoanNo() {
            const tbody = document.getElementById('khoanNoTableBody');
            try {
                const response = await fetch(KHOAN_NO_URL);
                if (!response.ok) throw new Error('Không thể tải danh sách khoản nợ');
                khoanNoList = await response.json();

                if (!khoanNoList.length) {
                    tbody.innerHTML = `<tr><td colspan="4" class="empty-state text-center">
                        <i class="bi bi-inbox"></i>Chưa có khoản nợ nào</td></tr>`;
                    return;
                }

                tbody.innerHTML = khoanNoList.map(item => `
                    <tr class="${selectedKhoanNoId === item.id ? 'table-active' : ''}">
                        <td><span class="text-muted">#${item.id}</span></td>
                        <td class="fw-semibold">${escapeHtml(item.tenKhoanNo)}</td>
                        <td>${formatNote(item.ghiChu)}</td>
                        <td>
                            <div class="btn-action-group">
                                <button class="btn btn-sm btn-outline-info btn-action" onclick="viewChiTiet(${item.id})" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-primary btn-action" onclick="openEditKhoanNo(${item.id})" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger btn-action" onclick="deleteKhoanNo(${item.id})" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join('');
            } catch (error) {
                tbody.innerHTML = `<tr><td colspan="4" class="empty-state text-center text-danger">${error.message}</td></tr>`;
            }
        }

        function resetKhoanNoForm() {
            document.getElementById('khoanNoId').value = '0';
            document.getElementById('tenKhoanNo').value = '';
            document.getElementById('ghiChuKhoanNo').value = '';
            document.getElementById('khoanNoModalTitle').textContent = 'Thêm khoản nợ';
        }

        document.getElementById('btnAddKhoanNo').addEventListener('click', () => {
            resetKhoanNoForm();
            khoanNoModal.show();
        });

        function openEditKhoanNo(id) {
            const item = khoanNoList.find(x => x.id === id);
            if (!item) return;

            document.getElementById('khoanNoId').value = item.id;
            document.getElementById('tenKhoanNo').value = item.tenKhoanNo;
            document.getElementById('ghiChuKhoanNo').value = item.ghiChu || '';
            document.getElementById('khoanNoModalTitle').textContent = 'Sửa khoản nợ';
            khoanNoModal.show();
        }

        document.getElementById('btnSaveKhoanNo').addEventListener('click', async () => {
            const id = parseInt(document.getElementById('khoanNoId').value, 10);
            const tenKhoanNo = document.getElementById('tenKhoanNo').value.trim();
            if (!tenKhoanNo) {
                showAlert('alertBox', 'Vui lòng nhập tên khoản nợ', 'warning');
                return;
            }

            const payload = {
                id: id,
                tenKhoanNo: tenKhoanNo,
                ghiChu: document.getElementById('ghiChuKhoanNo').value.trim() || null
            };

            const isEdit = id > 0;
            try {
                const response = await fetch(KHOAN_NO_URL, {
                    method: isEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) throw new Error('Lưu khoản nợ thất bại');

                khoanNoModal.hide();
                showAlert('alertBox', isEdit ? 'Cập nhật khoản nợ thành công' : 'Thêm khoản nợ thành công');
                await loadKhoanNo();
            } catch (error) {
                showAlert('alertBox', error.message, 'danger');
            }
        });

        async function deleteKhoanNo(id) {
            if (!confirm('Bạn có chắc muốn xóa khoản nợ này?')) return;

            try {
                const response = await fetch(`${KHOAN_NO_URL}/${id}`, { method: 'DELETE' });
                if (!response.ok) throw new Error('Xóa khoản nợ thất bại');

                if (selectedKhoanNoId === id) {
                    selectedKhoanNoId = 0;
                    document.getElementById('chiTietSection').classList.add('d-none');
                }

                showAlert('alertBox', 'Xóa khoản nợ thành công');
                await loadKhoanNo();
            } catch (error) {
                showAlert('alertBox', error.message, 'danger');
            }
        }

        async function loadThongKe(khoanNoId) {
            try {
                const response = await fetch(`${CHI_TIET_URL}/ThongKe/${khoanNoId}`);
                if (!response.ok) throw new Error('Không thể tải thống kê');
                const stats = await response.json();

                document.getElementById('tongTienVay').textContent = formatMoney(stats.tongTienVay);
                document.getElementById('tongTienLai').textContent = formatMoney(stats.tongTienLai);
                document.getElementById('tongTienPhaiTra').textContent = formatMoney(stats.tongTienPhaiTra);
            } catch (error) {
                showAlert('alertBox', error.message, 'danger');
            }
        }

        async function loadChiTiet(khoanNoId) {
            const tbody = document.getElementById('chiTietTableBody');
            try {
                const response = await fetch(`${CHI_TIET_URL}/KhoanNo/${khoanNoId}`);
                if (!response.ok) throw new Error('Không thể tải chi tiết khoản vay');
                chiTietList = await response.json();

                if (!chiTietList.length) {
                    tbody.innerHTML = `<tr><td colspan="9" class="empty-state text-center">
                        <i class="bi bi-inbox"></i>Chưa có chi tiết khoản vay</td></tr>`;
                    return;
                }

                tbody.innerHTML = chiTietList.map(item => `
                    <tr>
                        <td><span class="text-muted">#${item.id}</span></td>
                        <td>${formatDate(item.ngayVay)}</td>
                        <td class="money-cell">${formatMoney(item.soTienVay)}</td>
                        <td class="money-cell">${formatMoney(item.soTienLai)}</td>
                        <td class="money-cell">${formatMoney(item.soTienTraMoiThang)}</td>
                        <td>${item.ngayDenHan ?? '<span class="text-muted">—</span>'}</td>
                        <td class="money-cell fw-semibold">${formatMoney(item.tongTien)}</td>
                        <td>${formatNote(item.ghiChu)}</td>
                        <td>
                            <div class="btn-action-group">
                                <button class="btn btn-sm btn-outline-primary btn-action" onclick="openEditChiTiet(${item.id})" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger btn-action" onclick="deleteChiTiet(${item.id})" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join('');
            } catch (error) {
                tbody.innerHTML = `<tr><td colspan="9" class="empty-state text-center text-danger">${error.message}</td></tr>`;
            }
        }

        async function viewChiTiet(khoanNoId) {
            const item = khoanNoList.find(x => x.id === khoanNoId);
            selectedKhoanNoId = khoanNoId;
            document.getElementById('selectedKhoanNoName').textContent = item ? item.tenKhoanNo : '';
            document.getElementById('chiTietSection').classList.remove('d-none');
            document.getElementById('chiTietSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
            await loadKhoanNo();
            await loadThongKe(khoanNoId);
            await loadChiTiet(khoanNoId);
        }

        function resetChiTietForm() {
            document.getElementById('chiTietId').value = '0';
            document.getElementById('chiTietKhoanNoId').value = selectedKhoanNoId;
            document.getElementById('ngayVay').value = new Date().toISOString().split('T')[0];
            document.getElementById('soTienVay').value = '0';
            document.getElementById('soTienLai').value = '0';
            document.getElementById('soTienTraMoiKy').value = '0';
            document.getElementById('soNgayTra').value = '0';
            document.getElementById('tongTien').value = '0';
            document.getElementById('ghiChuChiTiet').value = '';
            document.getElementById('chiTietModalTitle').textContent = 'Thêm chi tiết khoản vay';
        }

        document.getElementById('btnAddChiTiet').addEventListener('click', () => {
            if (!selectedKhoanNoId) {
                showAlert('alertBox', 'Vui lòng chọn khoản nợ trước', 'warning');
                return;
            }
            resetChiTietForm();
            chiTietModal.show();
        });

        function openEditChiTiet(id) {
            const item = chiTietList.find(x => x.id === id);
            if (!item) return;

            document.getElementById('chiTietId').value = item.id;
            document.getElementById('chiTietKhoanNoId').value = item.khoanNoId;
            document.getElementById('ngayVay').value = item.ngayVay;
            document.getElementById('soTienVay').value = item.soTienVay;
            document.getElementById('soTienLai').value = item.soTienLai;
            document.getElementById('soTienTraMoiKy').value = item.soTienTraMoiThang || 0;
            document.getElementById('soNgayTra').value = item.ngayDenHan || 0;
            document.getElementById('tongTien').value = item.tongTien || 0;
            document.getElementById('ghiChuChiTiet').value = item.ghiChu || '';
            document.getElementById('chiTietModalTitle').textContent = 'Sửa chi tiết khoản vay';
            chiTietModal.show();
        }

        document.getElementById('btnSaveChiTiet').addEventListener('click', async () => {
            const id = parseInt(document.getElementById('chiTietId').value, 10);
            const khoanNoId = parseInt(document.getElementById('chiTietKhoanNoId').value, 10);
            const ngayVay = document.getElementById('ngayVay').value;

            if (!ngayVay) {
                showAlert('alertBox', 'Vui lòng chọn ngày vay', 'warning');
                return;
            }

            const payload = {
                id: id,
                khoanNoId: khoanNoId,
                ngayVay: ngayVay,
                soTienVay: parseFloat(document.getElementById('soTienVay').value) || 0,
                soTienLai: parseFloat(document.getElementById('soTienLai').value) || 0,
                soTienTraMoiThang: parseFloat(document.getElementById('soTienTraMoiKy').value) || 0,
                ngayDenHan: parseInt(document.getElementById('soNgayTra').value, 10) || 0,
                tongTien: parseFloat(document.getElementById('tongTien').value) || 0,
                ghiChu: document.getElementById('ghiChuChiTiet').value.trim() || null
            };

            const isEdit = id > 0;
            try {
                const response = await fetch(CHI_TIET_URL, {
                    method: isEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) throw new Error('Lưu chi tiết thất bại');

                chiTietModal.hide();
                showAlert('alertBox', isEdit ? 'Cập nhật chi tiết thành công' : 'Thêm chi tiết thành công');
                await loadThongKe(khoanNoId);
                await loadChiTiet(khoanNoId);
            } catch (error) {
                showAlert('alertBox', error.message, 'danger');
            }
        });

        async function deleteChiTiet(id) {
            if (!confirm('Bạn có chắc muốn xóa chi tiết này?')) return;

            try {
                const response = await fetch(`${CHI_TIET_URL}/${id}`, { method: 'DELETE' });
                if (!response.ok) throw new Error('Xóa chi tiết thất bại');

                showAlert('alertBox', 'Xóa chi tiết thành công');
                await loadThongKe(selectedKhoanNoId);
                await loadChiTiet(selectedKhoanNoId);
            } catch (error) {
                showAlert('alertBox', error.message, 'danger');
            }
        }

        loadKhoanNo();
    </script>
}
